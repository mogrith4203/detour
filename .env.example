# Copy this file to .env and fill in ONE key. Never commit .env.

# Option A: build.nvidia.com (log in, open the model, click "View Code", copy the key)
NVIDIA_API_KEY=
# Option B: OpenRouter
OPENROUTER_API_KEY=

# Copy the exact model id from the "View Code" sample on build.nvidia.com
# (or from the model page on OpenRouter). This default is a guess.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning

# Optional: override the endpoint (defaults to integrate.api.nvidia.com for NVIDIA keys, openrouter.ai for OpenRouter keys)
# NEMOTRON_BASE_URL=

# off = ask the model to skip long reasoning (faster demo). Set to "on" to allow it.
NEMOTRON_THINKING=off

# 1 = run fully offline with deterministic stand-ins (UI shows MOCK MODE)
DETOUR_MOCK=0
